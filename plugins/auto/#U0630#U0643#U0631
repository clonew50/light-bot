// ⚠️ ضع آيدي الجروب المستهدف هنا (احذف النص المكتوب وضع الآيدي مكانه)
const targetGroupJid = "120363428425887009@g.us" 

export default async function before(m, { conn }) {
  global.azkarStarted = global.azkarStarted || false

  if (global.azkarStarted) return false
  global.azkarStarted = true

  const sendAzkar = async () => {
    try {
      // التحقق مما إذا كان هذا البوت فرعياً (Jadibot) أم البوت الأساسي
      const isSubBot = conn.user && conn.user.jid && conn.user.jid !== global.conn?.user?.jid

      let chats = Object.keys(conn.chats || {})
      if (chats.length === 0 && conn.groupFetchAllParticipating) {
        const groups = await conn.groupFetchAllParticipating().catch(() => ({}))
        chats = Object.keys(groups)
      }

      // مصفوفة لتخزين وعود الإرسال لإرسالها دفعة واحدة
      const sendPromises = chats.map(async (jid) => {
        if (!jid.endsWith('@g.us')) return

        // 🛑 شرط المنع: إذا كان البوت فرعياً والمجموعة هي المجموعة المستهدفة، يتم التخطي فوراً
        if (isSubBot && jid === targetGroupJid) return

        const zekr = azkar[Math.floor(Math.random() * azkar.length)]

        return conn.sendMessage(jid, {
          text: `❐═━━━═╊🕌╉═━━━═❐\n\n${zekr}\n\n❐═━━━═╊🕌╉═━━━═❐`
        }).catch(() => null)
      })

      // إرسال لجميع المجموعات دفعة واحدة بدون أي تأخير بينها
      await Promise.all(sendPromises)

    } catch (err) {
      console.error('خطأ في نظام الأذكار التلقائي:', err)
    }
  }

  // تشغيل فوري مع استقبال أول رسالة
  sendAzkar()

  // العداد التلقائي كل 10 دقائق
  setInterval(sendAzkar, 10 * 60 * 1000)

  return false
}
